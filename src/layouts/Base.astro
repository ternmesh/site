---
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
    /** Keep the page out of search engines: one whose content comes from the link that opened it. */
    noindex?: boolean;
}

const {
    title,
    description = "Tern is an open LoRa mesh protocol that treats airtime as a shared, metered resource.",
    noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · Tern` : "Tern — an open LoRa mesh protocol";
const canonical = new URL(Astro.url.pathname, Astro.site);
const org = "https://github.com/ternmesh";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex" />}
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
    </head>
    <body>
        <a class="skip" href="#main">Skip to the content</a>
        <header class="site-header">
            <nav class="wrap">
                <a class="brand" href="/">
                    <img src="/favicon.svg" alt="" width="28" height="28" />
                    Tern
                </a>
                <div class="links">
                    <a href="/app">App</a>
                    <a href="/flash">Flash</a>
                    <a href="/apps">Get the apps</a>
                    <a href={`${org}/spec`}>Spec</a>
                    <a href={org}>GitHub</a>
                </div>
            </nav>
        </header>
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <footer class="site-footer">
            <div class="wrap muted">
                Site under the Apache License 2.0 · <a href={`${org}/site`}>Source</a> ·
                <a href="/privacy">Privacy</a> ·
                <a href={`${org}/spec/blob/main/GOVERNANCE.md`}>Governance</a>
                <br />
                Tern is an independent project, not affiliated with any other mesh project.
            </div>
        </footer>
    </body>
</html>

<style>
    .site-header {
        border-bottom: 1px solid var(--border);
    }
    .site-header nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 60px;
        flex-wrap: wrap;
    }
    .brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--text);
        text-decoration: none;
    }
    .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.25rem 1.25rem;
    }
    /* On a phone the links take a row of their own under the name, and wrap within it. */
    @media (max-width: 40rem) {
        .site-header nav {
            gap: 0.25rem;
            padding-top: 10px;
            padding-bottom: 10px;
        }
        .links {
            width: 100%;
            gap: 0.25rem 1rem;
            font-size: 0.95rem;
        }
        .links a {
            padding: 4px 0;
        }
    }
    .links a {
        color: var(--muted);
        text-decoration: none;
    }
    .links a:hover {
        color: var(--text);
    }
    .skip {
        position: absolute;
        left: 16px;
        top: -100px;
        z-index: 10;
        padding: 8px 12px;
        border-radius: var(--radius);
        background: var(--surface);
        border: 1px solid var(--border);
    }
    .skip:focus {
        top: 8px;
    }
    main:focus {
        outline: none;
    }
    .site-footer {
        margin-top: 4rem;
        padding: 2rem 0;
        border-top: 1px solid var(--border);
        font-size: 0.875rem;
    }
</style>
