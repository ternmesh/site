---
import { readFileSync } from "node:fs";
import { join } from "node:path";

import Base from "../layouts/Base.astro";
import release from "../data/firmware.json";
import { boards, familyOf, makers } from "../data/boards.ts";
import { layoutOf, parseSums, regionsOf, REGIONS, uf2Name } from "../lib/flash/images.ts";
import type { Region } from "../lib/flash/images.ts";
import type { Offer } from "../lib/flash/page.ts";

const org = "https://github.com/ternmesh";
const notes = `${org}/firmware/releases/tag/v${release.version}`;
const checklist = `${org}/firmware/blob/main/docs/boards.md#bringing-a-board-up`;

// tools/firmware.ts put the release here before the build. A board is offered for the regions
// the release has its images for; one from before the OTA layout cannot be updated from a phone.
const sums = parseSums(readFileSync(join(process.cwd(), "public", "firmware", "SHA256SUMS"), "utf8"));
const offers: Offer[] = boards.flatMap((b) => {
    const family = familyOf(b);
    const regions = regionsOf(release.version, b.name, family, sums);
    if (regions.length === 0) {
        return [];
    }
    return [
        {
            name: b.name,
            title: b.title,
            maker: b.maker,
            chip: b.chip,
            family,
            checked: b.status === "runs",
            note: b.note ?? "",
            ota: family === "esp32" && layoutOf(release.version, b.name, sums) === "ota",
            regions,
            files: Object.fromEntries(regions.map((r) => [r, family === "uf2" ? uf2Name(release.version, b.name, r) : ""])),
        },
    ];
});
const regions = REGIONS.filter((r) => offers.some((o) => o.regions.includes(r)));
const byMaker = Object.keys(makers).map((m) => ({ maker: m, offers: offers.filter((o) => o.maker === m) }));
const where: Record<Region, { place: string; profile: string }> = {
    us915: {
        place: "United States, Canada, Mexico, Brazil, Argentina or Peru",
        profile: "US915: 921.25 MHz",
    },
    eu868: {
        place: "Europe, the UK, Ukraine or South Africa",
        profile: "EU868: 869.475 MHz, at most 10% of any hour",
    },
    au915: { place: "Australia", profile: "AU915: 921.25 MHz, at most 30 dBm EIRP" },
    nz915: { place: "New Zealand", profile: "NZ915: 921.25 MHz" },
    cl915: { place: "Chile", profile: "CL915: 921.25 MHz, at most 26 dBm EIRP" },
    my919: { place: "Malaysia", profile: "MY919: 920.25 MHz, at most 26 dBm EIRP" },
    th920: { place: "Thailand", profile: "TH920: 921.25 MHz, at most 10% of any hour, at least 17 dBm EIRP" },
    ru868: { place: "Russia", profile: "RU868: 868.775 MHz, at most 10% of any hour" },
    kz863: { place: "Kazakhstan", profile: "KZ863: 864.375 MHz, at most 13 dBm EIRP" },
};
---

<Base
    title="Flash a board"
    description="Put Tern's firmware on a LoRa board from your browser, over USB, with nothing to install."
>
    <section class="flash wrap">
        <h1>Put Tern on a board</h1>
        <p class="lede">
            This writes Tern {release.version} to one of {offers.length} boards, from this page, with nothing to
            install. An ESP32 board is written over USB in about a minute; an nRF52840 board takes a file you copy
            onto it.
        </p>

        <ul class="notes">
            <li>
                <strong>Fit the antenna first.</strong> The board sends by radio as soon as it starts, and sending
                with nothing on the antenna connector can damage it.
            </li>
            <li>
                This is an alpha of a draft protocol. Its cryptography has not been reviewed: do not trust it
                with anything that matters. <a href={notes}>What it does and does not do.</a>
            </li>
        </ul>

        <form id="flash">
            <fieldset>
                <legend>Which board?</legend>
                <select id="board" name="board" aria-describedby="about">
                    {
                        byMaker.map(({ maker, offers }) => (
                            <optgroup label={maker}>
                                {offers.map((o) => (
                                    <option value={o.name} selected={o.name === "heltec-v3"}>
                                        {o.title}
                                    </option>
                                ))}
                            </optgroup>
                        ))
                    }
                </select>
                <div id="about">
                    <p id="checked" class="muted">Checked on a board with this release.</p>
                    <p id="unchecked" class="note" hidden>
                        <strong>Not yet checked on a board.</strong> The release builds for it, from its maker's pin
                        map, but nobody has yet said it works. If you try it, <a href={`${org}/firmware/issues`}>say
                        how it went</a>, with what the <a href={checklist}>checklist</a> asks: that is how a board
                        becomes one that is checked.
                    </p>
                    <p id="note" class="muted" hidden></p>
                </div>
                <p class="muted">
                    The page can tell which chip a board has, not which board it is: an image for another board with
                    the same chip is written and does not work. Pick the board printed on yours.
                </p>
            </fieldset>

            <fieldset>
                <legend>Where will the board be used?</legend>
                <p class="muted">
                    It sends on this region's frequency from the moment it starts, so the wrong one breaks the
                    rules of the place you are in.
                </p>
                {
                    regions.map((r) => (
                        <label data-region={r}>
                            <input type="radio" name="region" value={r} required />
                            {where[r].place} <span class="muted">{where[r].profile}</span>
                        </label>
                    ))
                }
                <p class="muted">Anywhere else: there is no image yet. Do not use one of these.</p>
            </fieldset>

            <div id="serial">
                <p id="unsupported" class="note" hidden>
                    This browser cannot reach a USB serial port. Chrome and Edge on a computer can; Safari, Firefox
                    and phones cannot yet. The <a href={notes}>release</a> has the images, to write another way.
                </p>
                <fieldset>
                    <legend>What is on the board now?</legend>
                    <label>
                        <input type="radio" name="kind" value="new" required />
                        Something else, or nothing
                        <span class="muted">
                            replaces it, Meshtastic or MeshCore and their settings included; the board gets a new
                            Tern address
                        </span>
                    </label>
                    <label>
                        <input type="radio" name="kind" value="update" required />
                        Tern already
                        <span class="muted">keeps its address, its sessions and its contacts</span>
                        <span id="ota" class="muted">
                            update it this way once, and from then on the Tern phone apps can update it over Bluetooth
                        </span>
                    </label>
                </fieldset>

                <p>
                    <button id="go" type="submit" class="primary">Flash over USB</button>
                </p>
                <p class="muted">
                    The browser asks which port: the board's is usually named for its USB chip, such as CP210x, CH340,
                    CH9102 or USB JTAG/serial. If the app or a terminal has the port open, close that first.
                </p>
            </div>

            <div id="uf2" class="card" hidden>
                <ol>
                    <li>
                        <a id="download" class="button" href="#" download>Download the image</a>
                        <span class="muted">Choose a region first.</span>
                    </li>
                    <li>
                        Plug the board in over USB and press its reset button twice, quickly. A drive appears, named for
                        the board's bootloader.
                    </li>
                    <li>
                        Copy the <code>.uf2</code> file onto the drive. The board writes it, restarts, and the drive
                        goes. This replaces Meshtastic or MeshCore if either is on it; copied over Tern, it keeps the
                        board's address, its sessions and its contacts.
                    </li>
                </ol>
                <p class="muted">
                    These boards cannot be updated from a phone yet: copy the next release's file on the same way.
                </p>
            </div>
        </form>

        <div id="working" class="card" hidden>
            <p id="status" role="status"></p>
            <progress id="bar"></progress>
            <p id="failed" class="muted" hidden>
                If the board would not go into its bootloader, hold its BOOT or PRG button, press and let go of RST,
                let go of the first, and try again. A cable that only charges does this too.
            </p>
            <p id="done" hidden>
                <a class="button" href="/app">Open the app</a>
            </p>
            <details>
                <summary>What the flasher said</summary>
                <pre id="log"></pre>
            </details>
        </div>

        <p class="muted small">
            The images are the <a href={notes}>v{release.version} release</a>'s, checked here against its{" "}
            <a href="/firmware/SHA256SUMS">SHA-256 checksums</a> before a byte is written, and written with
            Espressif's <a href="https://github.com/espressif/esptool-js">esptool-js</a>.
        </p>
    </section>
    <script id="offers" type="application/json" set:html={JSON.stringify(offers)} />
</Base>

<script>
    import "../lib/flash/page.ts";
</script>

<style>
    .flash {
        padding-top: 32px;
        padding-bottom: 48px;
        max-width: 48rem;
    }
    [hidden] {
        display: none !important;
    }
    h1 {
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        margin: 0 0 12px;
    }
    .lede {
        font-size: 1.1rem;
    }
    .notes {
        padding-left: 1.2em;
    }
    .notes li {
        margin-bottom: 6px;
    }
    select {
        font: inherit;
        padding: 6px 8px;
        border-radius: var(--radius);
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        max-width: 100%;
    }
    #about p {
        margin: 8px 0;
    }
    .card ol {
        padding-left: 1.2em;
    }
    .card li {
        margin-bottom: 8px;
    }
    a.button[aria-disabled="true"] {
        opacity: 0.5;
        pointer-events: none;
    }
    .note,
    .card {
        background: var(--accent-soft);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 10px 14px;
    }
    .card {
        background: var(--surface);
        margin: 16px 0;
    }
    fieldset {
        border: 1px solid var(--border);
        border-radius: var(--radius);
        margin: 16px 0;
        padding: 10px 14px;
    }
    legend {
        font-weight: 600;
        padding: 0 6px;
    }
    fieldset label {
        display: block;
        padding: 6px 0;
        cursor: pointer;
    }
    fieldset label .muted {
        display: block;
        margin-left: 1.6em;
        font-size: 0.9rem;
    }
    fieldset p {
        margin: 4px 0;
        font-size: 0.95rem;
    }
    button,
    a.button {
        display: inline-block;
        font: inherit;
        padding: 9px 16px;
        border-radius: var(--radius);
        border: 1px solid var(--accent);
        background: var(--accent);
        color: var(--bg);
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }
    button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    progress {
        width: 100%;
        height: 12px;
        accent-color: var(--accent);
    }
    #status.bad {
        color: #b3261e;
    }
    @media (prefers-color-scheme: dark) {
        #status.bad {
            color: #f2b8b5;
        }
    }
    pre {
        font-size: 0.8rem;
        max-height: 16rem;
        overflow: auto;
        white-space: pre-wrap;
    }
    .small {
        font-size: 0.9rem;
    }
</style>
