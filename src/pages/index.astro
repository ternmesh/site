---
import Base from "../layouts/Base.astro";
import release from "../data/firmware.json";

const org = "https://github.com/ternmesh";

const ideas = [
    {
        title: "Airtime is budgeted",
        body: "Every node has an airtime budget, and the network accounts for what it spends. A busy channel degrades fairly instead of collapsing.",
    },
    {
        title: "Addresses are public keys",
        body: "A node is named by its key, so who you are talking to is something you can check, not something you are told.",
    },
    {
        title: "Each link picks its own speed",
        body: "Close neighbours talk fast and distant ones talk slow, inside a loosely synchronised schedule, so one slow link does not slow the whole mesh.",
    },
    {
        title: "Infrastructure and leaves",
        body: "Fixed relays carry the routing. Handhelds and sensors are leaves that can sleep on a schedule and still receive their messages.",
    },
    {
        title: "Private by default",
        body: "What goes over the air is meant to reveal as little as possible about who is talking to whom.",
    },
    {
        title: "Gateways are peers",
        body: "Bridges to the internet or to other meshes sit at the application layer, not inside the routing.",
    },
];

const repos = [
    { name: "spec", body: "The specification and conformance test vectors. This is the protocol." },
    { name: "sim", body: "A simulator, calibrated on real SX1262 radios, that decides the routing design." },
    { name: "firmware", body: "The reference implementation, one of any number that can exist." },
];
---

<Base>
    <section class="hero wrap">
        <p class="status">Alpha · a draft protocol</p>
        <h1>Tern</h1>
        <p class="lede">
            An open LoRa mesh protocol that treats airtime as a shared, metered resource.
        </p>
        <p class="cta">
            <a class="button" href="#start">Get started</a>
            <a class="button secondary" href="/app">Open the app</a>
            <a class="button secondary" href="/why">Why Tern</a>
        </p>
        <p class="muted small">
            It runs today: firmware {release.version} for one board, an app for Android, a beta for iPhone, iPad
            and Mac in TestFlight, and an app in the browser. It is an alpha of a draft protocol. Its cryptography
            has not been reviewed: do not trust it with anything that matters.
        </p>
    </section>

    <section class="wrap" id="start">
        <h2>Get started</h2>
        <ol class="steps">
            <li class="card">
                <h3>A board</h3>
                <p>
                    A <strong>Heltec WiFi LoRa 32 V3</strong>, the 863-928 MHz kind, with its antenna. It is the one
                    board Tern runs on today. The Heltec V4 and the Heltec Mesh Node T114 are built but not yet run
                    on a board.
                </p>
            </li>
            <li class="card">
                <h3>Flash it</h3>
                <p>
                    <a href="/flash">Put Tern on it</a> from Chrome or Edge on a computer, over USB, with nothing to
                    install. It replaces Meshtastic or MeshCore if either is on the board.
                </p>
            </li>
            <li class="card">
                <h3>An app</h3>
                <p>
                    <a href="/apps#android">Android</a>, <a href="/apps#apple">iPhone, iPad or Mac</a> (a TestFlight
                    beta), or <a href="/app">the app in your browser</a>, in Chrome or Edge. Each talks to the node
                    over Bluetooth; the browser can use USB too.
                </p>
            </li>
            <li class="card">
                <h3>Add someone</h3>
                <p>
                    Scan their node's QR code, or open its link, and add them as a contact. Compare the twelve-digit
                    code with them to check it is their node. Then write.
                </p>
            </li>
        </ol>
        <p class="muted">
            Two boards, one for each of you, are the least that makes a conversation. Where you are matters: the
            firmware has images for the US915 and EU868 regions only.
        </p>
    </section>

    <section class="wrap" id="ideas">
        <h2>What it is built around</h2>
        <p class="muted">
            These are design goals. Each one is being tested in simulation and on real radios
            before it becomes part of the specification.
        </p>
        <ul class="grid">
            {
                ideas.map((idea) => (
                    <li class="card">
                        <h3>{idea.title}</h3>
                        <p>{idea.body}</p>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="wrap">
        <h2>How it is being built</h2>
        <p>
            Specification first. Routing is decided by simulation before any of it is written
            down, and the simulator is calibrated against bench measurements of real radios.
            An implementation is Tern-compatible if it passes the published conformance tests;
            nobody's permission is needed.
        </p>
        <ul class="grid repos">
            {
                repos.map((repo) => (
                    <li class="card">
                        <h3>
                            <a href={`${org}/${repo.name}`}>ternmesh/{repo.name}</a>
                        </h3>
                        <p>{repo.body}</p>
                    </li>
                ))
            }
        </ul>
    </section>

    <section class="wrap">
        <h2>Open for good</h2>
        <ul class="plain">
            <li>The specification is CC-BY-4.0, the test vectors CC0, the code Apache-2.0.</li>
            <li>Contributions are signed off under the DCO. There is no CLA.</li>
            <li>The specification will never need a fee, membership or certification to implement.</li>
            <li>The name, this domain and the GitHub organisation are held for the project, not for a company.</li>
        </ul>
        <p>
            The commitments are in full in <a href={`${org}/spec/blob/main/GOVERNANCE.md`}>GOVERNANCE.md</a>.
        </p>
    </section>
</Base>

<style>
    .hero {
        padding-top: 4rem;
        padding-bottom: 2rem;
    }
    .status {
        display: inline-block;
        margin: 0;
        padding: 0.2rem 0.7rem;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 600;
    }
    h1 {
        font-size: clamp(2.6rem, 8vw, 4rem);
        margin: 0.75rem 0 0.25rem;
    }
    .lede {
        font-size: clamp(1.15rem, 3vw, 1.4rem);
        color: var(--muted);
        max-width: 36rem;
        margin: 0;
    }
    section + section {
        margin-top: 3rem;
    }
    .grid {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
        gap: 1rem;
    }
    .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
    }
    .card h3 {
        margin: 0 0 0.4rem;
        font-size: 1.05rem;
    }
    .card p {
        margin: 0;
        color: var(--muted);
    }
    .repos h3 a {
        text-decoration: none;
    }
    .plain {
        padding-left: 1.2rem;
    }
    .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 1.5rem 0 0.75rem;
    }
    .small {
        font-size: 0.9rem;
        max-width: 40rem;
    }
    .steps {
        list-style: none;
        padding: 0;
        counter-reset: step;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
        gap: 1rem;
    }
    .steps li {
        counter-increment: step;
    }
    .steps h3::before {
        content: counter(step) ". ";
        color: var(--accent);
    }
    a.button {
        display: inline-block;
        padding: 9px 16px;
        border-radius: var(--radius);
        border: 1px solid var(--accent);
        background: var(--accent);
        color: var(--bg);
        font-weight: 600;
        text-decoration: none;
    }
    a.button.secondary {
        background: transparent;
        color: var(--accent);
    }
</style>
