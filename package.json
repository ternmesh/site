{
    "name": "ternmesh-site",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node tools/firmware.ts && astro dev",
        "firmware": "node tools/firmware.ts",
        "build": "node tools/firmware.ts && astro check && astro build",
        "test": "node --test \"tests/*.test.ts\"",
        "preview": "npm run build && wrangler dev",
        "deploy": "npm run build && wrangler deploy"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "dependencies": {
        "astro": "^7.3.5",
        "esptool-js": "^0.7.0"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@types/node": "^22.20.4",
        "typescript": "^6.0.3",
        "wrangler": "^4.146.0"
    }
}
