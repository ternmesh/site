# Apple fetches apple-app-site-association, at either path, and wants it as JSON. The file has no
# extension, so without these it would be served as application/octet-stream.
/apple-app-site-association
  Content-Type: application/json
/.well-known/apple-app-site-association
  Content-Type: application/json

# A group's join code (draft/groups.md in ternmesh/spec): its page reads the group's secret out of
# the link, in the browser. So the page may run only the site's own scripts and styles, load
# nothing from anywhere else, connect to nothing, be framed by nobody, and send no Referer. The
# one inline <style> Astro writes into the page is why styles allow 'unsafe-inline'; a style
# cannot send anything where images, fonts and connections are the site's own or none.
/G
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/g
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/group/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
/group
